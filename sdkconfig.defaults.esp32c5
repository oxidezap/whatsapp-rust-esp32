# ESP32-C5 N16R8 (validated on the Waveshare ESP32-C5-Touch-LCD-2.8). Read by
# esp-idf-sys after sdkconfig.defaults whenever MCU=esp32c5. Needs ESP-IDF v5.5,
# which scripts/build.sh selects; v5.4 does not know the chip.

# PSRAM: 8 MB quad SPI (the C5 has no octal mode)
CONFIG_SPIRAM_MODE_QUAD=y

# The board exposes the chip's native USB Serial/JTAG endpoint, not a UART
# bridge. It must be the primary console for bidirectional command input; a
# secondary console is output-only.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
