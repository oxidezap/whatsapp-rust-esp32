# Copy to `.env` and fill in (gitignored). Values are baked into the firmware at
# build time, so changing them needs a rebuild + reflash.

WIFI_SSID=your-ssid          # 2.4 GHz only
WIFI_PASS=your-password

# Optional; falls back to the mock URL in src/main.rs.
WHATSAPP_WS_URL=wss://192.168.0.4:8080/ws/chat

# Optional; the name this device pairs under (default "esp32-test"). Against the
# mock server the push name also selects the account. A `push_name` string in the
# `wa` namespace of the default NVS partition overrides it at flash time, which is
# how several boards can share one firmware image (see README "Configure").
WHATSAPP_PUSH_NAME=esp32-test
