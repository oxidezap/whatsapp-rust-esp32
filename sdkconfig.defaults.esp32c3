# ESP32-C3. Read by esp-idf-sys after sdkconfig.defaults whenever MCU=esp32c3.
#
# The C3 is the first supported chip with NO PSRAM: ~400 KB of on-chip SRAM is
# the entire memory system, and roughly 300 KB of that reaches the heap once the
# static allocations are in. Every setting here exists to buy back internal DRAM
# that the S3 and C5 do not have to think about, because they push the same
# bytes into an 8 MB external heap.
#
# The matching source-side half is that `src/runtime.rs` sizes its thread stacks
# and `src/main.rs` picks its global allocator from `esp_idf_spiram`, the cfg
# esp-idf-sys derives from CONFIG_SPIRAM. Nothing below is a chip-detection
# trick in Rust; it is this file being read, and the cfg following from it.

# 160 MHz is the C3's maximum (the S3 and C5 run at 240).
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y

# --- Internal DRAM budget ---------------------------------------------------

# The main task's stack is internal DRAM held for the life of the firmware, and
# main() parks in a join() after handing off. 32 KB is what the S3 needs for the
# one-time NVS replay at boot with a fully populated store; the C3 cannot spare
# it permanently. 20 KB is the size this port boots on (see docs/esp32c3.md for
# the measured headroom); it is the one number here to re-check if the store
# format ever grows.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=20480

# Any std::thread spawned without an explicit ThreadSpawnConfiguration takes
# this. Everything in src/ names its own size; this is the floor for the rest
# (esp-idf-svc's internal helpers), and 32 KB of it is pure loss here.
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192

# WiFi buffers, trimmed from the shared defaults (10/32/32). Each static RX
# buffer is ~1.6 KB of DRAM that is allocated whether or not traffic arrives.
# This firmware is one long-lived TLS connection with small frames, not a
# throughput workload, so the queue depth costs more than it returns.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=1
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_NVS_ENABLED=y

# lwIP: the window sizes are what cost DRAM, not the socket count, so the
# buffers come down and the table does not. ESP-IDF's httpd reserves 3 sockets
# for itself and refuses to start unless LWIP_MAX_SOCKETS leaves room for its
# `max_open_sockets` on top (4, esp-idf-svc's default, in src/admin.rs); at 6
# the dashboard fails to bind and takes the firmware's startup with it. 10 is
# the ESP-IDF default and leaves the gateway's TLS socket, DNS and SNTP room
# beside it.
CONFIG_LWIP_MAX_SOCKETS=10
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5760
CONFIG_LWIP_TCP_WND_DEFAULT=5760
CONFIG_LWIP_TCP_RECVMBOX_SIZE=6
CONFIG_LWIP_UDP_RECVMBOX_SIZE=6
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16

# mbedTLS: the single largest RAM item after the stacks. CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC
# does not exist without PSRAM, so these buffers come out of internal DRAM, and
# the only lever left is how large they are and when they are taken.
#
# CONFIG_MBEDTLS_DYNAMIC_BUFFER is deliberately NOT set here, and that is the
# opposite of the obvious choice -- it is the feature ESP-IDF added for exactly
# this class of chip, and it was enabled here first. It is off because it is what
# broke the QEMU end-to-end run, twice.
#
# Under that feature the receive buffer is freed after every record and
# re-allocated for the next one, sized from the record header just read off the
# wire: `esp_mbedtls_add_rx_buffer` allocates `record_length + 341`. Two things
# follow. The size is the peer's choice, so no sdkconfig value bounds it -- the
# run that asked for `alloc(16749 bytes)` asked for exactly the same 16749 after
# CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN was lowered to 8192, because 16749 is
# 16408 (what the header claimed) plus 341, not 16384 plus overhead. And the
# request lands mid-session, against a heap that by then holds a live TLS
# session, a tearing-down one and the protocol state on top of both; a 314 KB
# heap could not produce a contiguous block that size, and the firmware went on
# to fail a 4,192-byte allocation and abort.
#
# There is a second reason, and it is a correctness one. This transport polls
# with a 100 ms read timeout (src/transport.rs), so `esp_tls_conn_read` returns
# WANT_READ in the middle of a record routinely. Freeing and rebuilding the
# receive buffer around a partially-read record header is the fragile path in
# that implementation, and a claimed record length of 16408 on a connection
# whose largest frame the server ever sent was 634 bytes is what a desynchronised
# header looks like.
#
# Without it mbedTLS allocates its record buffers once, inside the handshake,
# when the heap is at its least fragmented, and never asks again. That costs
# ~21 KB held for the life of the session instead of ~4 KB between records --
# paid for below and in the WebSocket buffers in src/transport.rs.
#
# Asymmetric record buffers: a TLS peer may send up to a 16 KB record and we must
# be able to receive it, but nothing this firmware sends comes close, so the
# outgoing buffer does not have to match. Saves 12 KB against the symmetric 16 KB
# the shared defaults ask for. The incoming side stays at the full 16384: with
# static buffers a record larger than the buffer is a hard protocol failure, and
# the ceiling is the peer's to choose. MFL (RFC 6066) would cap it at 4096, but
# it needs the server to honour the extension and neither peer here does.
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096

# Trim ciphersuites and features the WhatsApp gateway and the mock server never
# negotiate. Each one is code in flash and, for the key exchanges, peak RAM
# during the handshake.
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=n
CONFIG_MBEDTLS_DES=n
CONFIG_MBEDTLS_CAMELLIA_C=n
CONFIG_MBEDTLS_BLOWFISH_C=n
CONFIG_MBEDTLS_XTEA_C=n
CONFIG_MBEDTLS_CCM_C=n
CONFIG_MBEDTLS_KEY_EXCHANGE_RSA_PSK=n
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK=n
CONFIG_MBEDTLS_KEY_EXCHANGE_DHE_PSK=n
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_PSK=n
CONFIG_MBEDTLS_KEY_EXCHANGE_DHE_RSA=n

# --- Crash reporting --------------------------------------------------------
# With no PSRAM, no task stack can be in external memory, so ESP_COREDUMP_USE_STACK_SIZE
# is off and the dump runs on the crashed task's own stack. CONFIG_ESP_COREDUMP_STACK_SIZE
# is therefore absent here (it is set in the PSRAM overlays), and the task count
# comes down because there are fewer tasks and less room to describe them.
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=16

# --- Console ----------------------------------------------------------------
# Left at the ESP-IDF default, UART0, unlike the C5 overlay next door. The common
# ESP32-C3 devkits (DevKitM-1, DevKitC-02) bring UART0 out through a USB-serial
# bridge, and QEMU's `-serial` is that same UART0. Selecting the chip's native
# USB Serial/JTAG endpoint instead costs the emulator all output from the
# second-stage bootloader onwards -- the ROM still prints, because the ROM uses
# UART, which makes it look like a hang at `entry 0x...` rather than a console
# that went somewhere else. A board that is wired to the USB endpoint wants
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y here, and cannot then be run under QEMU.
