# ESP-IDF configuration shared by every supported board. esp-idf-sys also reads
# `sdkconfig.defaults.<mcu>` (after this file, so it wins), which is where the
# chip-specific parts live: PSRAM and where it is used, CPU frequency, console,
# cache layout. Add a board by adding that one file; nothing here should name a
# chip, and nothing here may assume a capability every chip does not have --
# which since the ESP32-C3 joined includes PSRAM itself.

# Flash: 16 MB on every supported board (N16R8 modules).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# The main task opens the 1 MB `wa_store` NVS partition and replays every record
# into RAM before the executor thread exists. 16 KB trips ESP-IDF's stack canary
# during that one-time scan on a populated store.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768

# Task watchdog stays enabled with a generous 30 s timeout (protocol init is slow).
# The idle task on core 0 is not watched: the `wa-blocking` worker runs prekey
# generation and other CPU-bound upstream jobs at priority 1 on that core, and a
# batch that legitimately outlasts the timeout would otherwise reboot the chip
# for starving idle. The executor thread registers itself instead (see
# `feed_task_watchdog` in src/main.rs), so a stalled event loop is still caught.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=32768

# WiFi
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
# esp-tls: allow skipping server certificate verification. The mock server mints a
# fresh ephemeral self-signed cert on every start, so verifying against any pinned CA
# is impossible. With these enabled AND no CA configured in esp_tls_cfg_t (see
# transport.rs when SKIP_TLS_VERIFY=true), esp-tls applies MBEDTLS_SSL_VERIFY_NONE.
# For the real WhatsApp gateway set SKIP_TLS_VERIFY=false in main.rs (uses the cert
# bundle and ignores these); these flags are inert unless the CA source is left unset.
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y

# mbedTLS: needed for TLS to WhatsApp servers. Where its buffers come from is a
# PSRAM decision rather than a per-chip one, so CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC
# lives in the shared `sdkconfig.psram` overlay, not here and not in the chip
# overlays.
CONFIG_MBEDTLS_SSL_MAX_CONTENT_LEN=16384
# Hardware AES accelerator.
CONFIG_MBEDTLS_HARDWARE_AES=y

# NVS: the default partition holds WiFi calibration and the optional provisioning
# namespace (see README "Configure"); `wa_store` holds the WhatsApp credentials.
CONFIG_NVS_ENCRYPTION=n

# SNTP: needed for correct timestamps
CONFIG_LWIP_SNTP_MAX_SERVERS=3

# Partition table: our custom partitions.csv (one large factory app). The ~4.3 MB
# firmware does NOT fit the built-in 1500K factory, so a custom table is required.
# esp-idf-sys builds in a generated cmake project at target/<triple>/<profile>/build/
# esp-idf-sys-<hash>/out, and ESP-IDF resolves CUSTOM_FILENAME relative to THAT dir,
# so we climb 6 levels back to the crate root. Works with the default target dir;
# a custom CARGO_TARGET_DIR would need this depth adjusted.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../../../../../partitions.csv"

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Crash core dump → flash (ELF format). Captures Rust panics AND hardware exceptions
# (LoadProhibited, etc.) to the coredump partition; read at boot via
# esp_core_dump_get_summary. NOT capturing DRAM keeps the dump small (<64 KB).
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=32

# Binary size reduction
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_NEWLIB_NANO_FORMAT=y
CONFIG_ESP_ERR_TO_NAME_LOOKUP=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_LWIP_IPV6=n
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
